{
  "name": "proof-of-grudge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/StevBeq/Proof-Of-Grudge",
  "engines": { "node": ">=22.15.1" },
  "packageManager": "npm@11.6.2",
  "workspaces": ["contract", "scripts", "web"],
  "scripts": {
    "dev": "npm --workspace proof-of-grudge-web run dev",
    "demo": "tsx scripts/run-demo.ts",
    "cli": "tsx scripts/cli.ts",
    "testnet:local": "tsx scripts/testnet-local.ts",
    "derive": "tsx scripts/derive-eth-address.ts",
    "vectors": "npm --workspace proof-of-grudge-rlp-vectors run vectors",
    "vectors:check": "npm --workspace proof-of-grudge-rlp-vectors run vectors:check",
    "test:contract": "node scripts/rust-toolchain.mjs test",
    "test:cli": "npm --workspace @proof-of-grudge/scripts run test",
    "test:web": "npm --workspace proof-of-grudge-web run test",
    "test": "npm run vectors:check && npm run test:contract && npm run test:cli && npm run test:web",
    "typecheck": "npm --workspace @proof-of-grudge/scripts run typecheck && npm --workspace proof-of-grudge-web run typecheck",
    "build:contract": "node scripts/rust-toolchain.mjs build",
    "build:web": "npm --workspace proof-of-grudge-web run build",
    "build": "npm run build:contract && npm run build:web"
  }
}
