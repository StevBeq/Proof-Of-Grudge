# Documentation only. The CLI never reads .env files or loads dotenv.
# A human must export variables into the inherited process environment or use
# a secure secret manager. Never pass private keys as CLI arguments.
VAULT_CONTRACT_ID=your-vault.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
OWNER_ACCOUNT_ID=your-owner.testnet
HEIR_ACCOUNT_ID=your-heir.testnet
RIVAL_ACCOUNT_ID=your-rival.testnet
# Intentionally blank. Never commit credentials or paste them into this example.
OWNER_PRIVATE_KEY=
HEIR_PRIVATE_KEY=
RIVAL_PRIVATE_KEY=
# User-selected positive yoctoNEAR amount; no live MPC fee is assumed.
# BEFORE requesting: the vault also needs at least this amount in EXTRA
# operating surplus for its failure-credit reserve, separate from storage,
# accounted vault assets, locked bonds, credits, and other reserved liabilities.
# Failure credit does not depend on receiving an asynchronous MPC refund.
MPC_SIGN_DEPOSIT_YOCTO=
