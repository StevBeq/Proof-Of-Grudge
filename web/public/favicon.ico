<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <rect width="32" height="32" rx="6" fill="#F2EBDD" stroke="#16130D" stroke-width="2"/>
  <!-- Tri-Seal Bullseye -->
  <circle cx="16" cy="16" r="10" fill="none" stroke="#16130D" stroke-width="2"/>
  <circle cx="16" cy="16" r="5" fill="none" stroke="#16130D" stroke-width="1.5" stroke-dasharray="2 2"/>
  <!-- 3 Adversarial Dots: Owner (Blue), Heir (Mustard), Rival (Red) -->
  <circle cx="16" cy="9" r="2.2" fill="#1E4FD8" stroke="#16130D" stroke-width="1"/>
  <circle cx="22" cy="19.5" r="2.2" fill="#E8B412" stroke="#16130D" stroke-width="1"/>
  <circle cx="10" cy="19.5" r="2.2" fill="#D7261E" stroke="#16130D" stroke-width="1"/>
</svg>
