{
  "config": {
    "heartbeat_ns": "120000000000",
    "grace_ns": "60000000000",
    "extension_ns": "60000000000",
    "bond_yocto": "1000000000000000000000000",
    "vault_yocto": "10000000000000000000000000"
  },
  "cases": [
    {
      "name": "False alarm credits Owner and resets heartbeat",
      "steps": [
        {"at_ns":"120000000001","actor":"heir","call":"initiate_claim","deposit":"1000000000000000000000000"},
        {"at_ns":"150000000000","actor":"owner","call":"check_in"}
      ],
      "expected": {"status":"Idle","outcome":"FalseAlarm","credits":{"owner":"1000000000000000000000000","heir":"0","rival":"0"},"vault_assets":"10000000000000000000000000"}
    },
    {
      "name": "Busted credits both bonds to Rival",
      "steps": [
        {"at_ns":"120000000001","actor":"heir","call":"initiate_claim","deposit":"1000000000000000000000000"},
        {"at_ns":"140000000000","actor":"rival","call":"challenge_claim","deposit":"1000000000000000000000000"},
        {"at_ns":"200000000000","actor":"owner","call":"check_in"}
      ],
      "expected": {"status":"Idle","outcome":"Busted","credits":{"owner":"0","heir":"0","rival":"2000000000000000000000000"},"vault_assets":"10000000000000000000000000"}
    },
    {
      "name": "Uncontested finalization at exact deadline is permissionless",
      "steps": [
        {"at_ns":"120000000001","actor":"heir","call":"initiate_claim","deposit":"1000000000000000000000000"},
        {"at_ns":"180000000001","actor":"anyone","call":"finalize_inheritance"}
      ],
      "expected": {"status":"Finalized","outcome":"Uncontested","credits":{"owner":"0","heir":"11000000000000000000000000","rival":"0"},"vault_assets":"0"}
    },
    {
      "name": "Spite backfired credits vault and both bonds to Heir",
      "steps": [
        {"at_ns":"120000000001","actor":"heir","call":"initiate_claim","deposit":"1000000000000000000000000"},
        {"at_ns":"140000000000","actor":"rival","call":"challenge_claim","deposit":"1000000000000000000000000"},
        {"at_ns":"240000000001","actor":"anyone","call":"finalize_inheritance"}
      ],
      "expected": {"status":"Finalized","outcome":"SpiteBackfired","credits":{"owner":"0","heir":"12000000000000000000000000","rival":"0"},"vault_assets":"0"}
    },
    {
      "name": "Check-in at exact deadline is rejected without changing credits",
      "steps": [
        {"at_ns":"120000000001","actor":"heir","call":"initiate_claim","deposit":"1000000000000000000000000"},
        {"at_ns":"180000000001","actor":"owner","call":"check_in","reject":true}
      ],
      "expected": {"status":"Pending","outcome":"None","credits":{"owner":"0","heir":"0","rival":"0"},"vault_assets":"10000000000000000000000000"}
    },
    {
      "name": "Check-in after Finalized is rejected",
      "steps": [
        {"at_ns":"120000000001","actor":"heir","call":"initiate_claim","deposit":"1000000000000000000000000"},
        {"at_ns":"180000000001","actor":"anyone","call":"finalize_inheritance"},
        {"at_ns":"190000000000","actor":"owner","call":"check_in","reject":true}
      ],
      "expected": {"status":"Finalized","outcome":"Uncontested","credits":{"owner":"0","heir":"11000000000000000000000000","rival":"0"},"vault_assets":"0"}
    },
    {
      "name": "Early finalization is rejected",
      "steps": [
        {"at_ns":"120000000001","actor":"heir","call":"initiate_claim","deposit":"1000000000000000000000000"},
        {"at_ns":"180000000000","actor":"anyone","call":"finalize_inheritance","reject":true}
      ],
      "expected": {"status":"Pending","outcome":"None","credits":{"owner":"0","heir":"0","rival":"0"},"vault_assets":"10000000000000000000000000"}
    },
    {
      "name": "An excessive bond is rejected in full",
      "steps": [
        {"at_ns":"120000000001","actor":"heir","call":"initiate_claim","deposit":"1000000000000000000000001","reject":true}
      ],
      "expected": {"status":"Idle","outcome":"None","credits":{"owner":"0","heir":"0","rival":"0"},"vault_assets":"10000000000000000000000000"}
    },
    {
      "name": "Idle owner withdrawal creates a separate pull-payment credit",
      "steps": [
        {"at_ns":"10000000000","actor":"owner","call":"owner_withdraw_near","amount":"3000000000000000000000000"}
      ],
      "expected": {"status":"Idle","outcome":"None","credits":{"owner":"3000000000000000000000000","heir":"0","rival":"0"},"vault_assets":"7000000000000000000000000"}
    }
  ]
}
